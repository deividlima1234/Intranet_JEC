{
  "name": "kiosk-client-electron",
  "version": "1.0.0",
  "description": "Cliente Kiosco JEC para Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder build --win --x64",
    "build:all": "node build_kiosks.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "pe.org.colegiohuanoquite.kiosk",
    "productName": "KioscoJEC",
    "win": {
      "target": [
        "portable"
      ],
      "requestedExecutionLevel": "highestAvailable"
    },
    "files": [
      "main.js",
      "package.json"
    ]
  }
}
